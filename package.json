{
  "name": "kerakbolsa",
  "version": "1.0.0",
  "private": true,
  "description": "KerakBo'lsa — rental marketplace (React + Express + MongoDB)",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c green,cyan \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
