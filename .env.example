# ─────────────────────────────────────────────────────────────
# KerakBo'lsa — backend environment (copy to backend/.env)
# Never commit real values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Leave EMPTY to use the built-in local
# development database (mongodb-memory-server, data kept in backend/.data).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kerakbolsa?retryWrites=true&w=majority
MONGODB_URI=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Optional — persistent image hosting. If empty, images are stored locally in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Simulated identity verification for demos (true/false)
DEMO_VERIFICATION=true

# Seed categories + clearly-labelled demo listings when the database is empty
SEED_ON_EMPTY=true
