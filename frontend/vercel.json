{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://kerakbolsa-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://kerakbolsa-api.onrender.com/uploads/:path*" },
    { "source": "/seed-images/:path*", "destination": "https://kerakbolsa-api.onrender.com/seed-images/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
